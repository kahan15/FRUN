# scripts/setup.sh creates fresh secrets in .env. Never commit .env or the data directory.
POSTGRES_PASSWORD=replace-with-random-url-safe-secret
JWT_SECRET=replace-with-at-least-32-random-characters
ENVIRONMENT=local
# Production must use explicit hosts, e.g. ["approved-api-host","localhost"], never "*".
ALLOWED_HOSTS=["*"]
BODY_TIMEOUT_SECONDS=60
DB_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
LOGIN_IP_ATTEMPTS_PER_WINDOW=60
REGISTRATION_ENABLED=true
# Recovery currently has only a local fake inbox; it never sends email.
# Enable only for synthetic local tests with a separate key from Fernet.generate_key().
RECOVERY_DELIVERY=disabled
RECOVERY_BASE_URL=http://127.0.0.1:8000
RECOVERY_ENCRYPTION_KEY=
RECOVERY_MINUTES=30
API_BIND_ADDRESS=0.0.0.0
COOLDOWN_HOURS=6
TERRITORY_DAYS=30
MONTHLY_RESET=false
SIMPLIFY_M=4
CLOSE_GAP_M=30
MIN_FRAGMENT_M2=200
MAX_LOOP_VERTICES=10000
MAX_LOOP_INTERSECTIONS=20000
ACCURACY_M=30
PACE_MARGIN=0.05
UPLOADS_PER_HOUR=20
# APNs is optional; keep the push profile off for a free personal build.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_KEY_PATH=
APNS_SANDBOX=true
