  "components": {
    "schemas": {
      "AccountDeletionLookup": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "AccountDeletionLookup"
      },
      "AccountDeletionRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "password"
        ],
        "title": "AccountDeletionRequest"
      },
      "AccountDeletionStatus": {
        "properties": {
          "completed": {
            "type": "boolean",
            "title": "Completed"
          }
        },
        "type": "object",
        "required": [
          "completed"
        ],
        "title": "AccountDeletionStatus"
      },
      "AuthResult": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "user": {
            "$ref": "#/components/schemas/UserPublic"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "user"
        ],
        "title": "AuthResult"
      },
      "DeviceRegistration": {
        "properties": {
          "apns_token": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64,200}$",
            "title": "Apns Token"
          },
          "platform": {
            "type": "string",
            "const": "ios",
            "title": "Platform",
            "default": "ios"
          },
          "app_version": {
            "type": "string",
            "maxLength": 30,
            "title": "App Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "apns_token",
          "app_version"
        ],
        "title": "DeviceRegistration"
      },
      "Fix": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "accuracy": {
            "type": "number",
            "minimum": 0.0,
            "title": "Accuracy"
          },
          "segment": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Segment",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "timestamp",
          "accuracy"
        ],
        "title": "Fix"
      },
      "FriendAction": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "FriendAction"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 254,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Refresh": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Refresh Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "Refresh"
      },
      "Register": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]{3,24}$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          },
          "display_name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Display Name"
          },
          "sex": {
            "type": "string",
            "enum": [
              "M",
              "F",
              "X"
            ],
            "title": "Sex",
            "default": "X"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "username",
          "password",
          "display_name"
        ],
        "title": "Register"
      },
      "RunResult": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "client_run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Run Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "fragment_count": {
            "type": "integer",
            "title": "Fragment Count"
          },
          "new_area_m2": {
            "type": "number",
            "title": "New Area M2"
          },
          "refreshed_area_m2": {
            "type": "number",
            "title": "Refreshed Area M2"
          },
          "blocked_area_m2": {
            "type": "number",
            "title": "Blocked Area M2"
          },
          "stolen_area_m2": {
            "type": "number",
            "title": "Stolen Area M2"
          },
          "steals": {
            "items": {
              "$ref": "#/components/schemas/Steal"
            },
            "type": "array",
            "title": "Steals"
          },
          "distance_m": {
            "type": "number",
            "title": "Distance M"
          },
          "duration_s": {
            "type": "number",
            "title": "Duration S"
          },
          "was_duplicate": {
            "type": "boolean",
            "title": "Was Duplicate",
            "default": false
